{
  "id": "./",
  "name": "Netiv Aryeh Library",
  "short_name": "Netiv Library",
  "description": "Search the Netiv Aryeh English and Hebrew library catalogs.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "background_color": "#edf5f8",
  "theme_color": "#090b16",
  "icons": [
    {
      "src": "1-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "2-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "prefer_related_applications": false
}
